# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=queueless_db
DB_USER=postgres
DB_PASSWORD=postgres

# Connection String Format:
# Host=127.0.0.1;Port=5433;Database=queueless_db;Username=postgres;Password=postgres

# JWT Authentication
JWT_SECRET=SuperSecretKeyForQueueLessAppSecurity2026!Min32BytesRequired
JWT_ISSUER=QueueLessApi
JWT_AUDIENCE=QueueLessApp
JWT_EXPIRATION_MINUTES=120

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Platform Admin Seed Credentials (Development Only)
ADMIN_EMAIL=platformadmin@queueless.local
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Administrator
